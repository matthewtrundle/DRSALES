# Resend API Key (from resend.com dashboard)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email Chris receives notifications at
NOTIFICATION_EMAIL=chris@example.com

# From address (must be verified domain in Resend)
FROM_EMAIL=Dr. Sales Office <noreply@drchristophersales.com>

# Google Analytics 4 Measurement ID (from GA4 dashboard > Admin > Data Streams)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console site verification meta tag value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
